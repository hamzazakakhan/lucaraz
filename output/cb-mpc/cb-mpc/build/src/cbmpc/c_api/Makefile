	cd /home/kali/CascadeProjects/VULSCAN-X/output/cb-mpc/cb-mpc/build && $(MAKE) $(MAKESILENT) -f src/cbmpc/c_api/CMakeFiles/cbmpc_c_api.dir/build.make src/cbmpc/c_api/CMakeFiles/cbmpc_c_api.dir/schnorr_mp.cpp.i
.PHONY : schnorr_mp.cpp.i

